{
  "name": "commscribe",
  "productName": "Commscribe",
  "version": "1.1.0",
  "description": "Radio log with real-time transcription and translation",
  "author": {
    "name": "Furo Engineering",
    "url": "https://furoengineering.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krfuro/commscribe.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "backend": "python3 -m PyInstaller --noconfirm --clean ../packaging/commscribe-backend.spec --distpath resources/backend-dist --workpath ../build/pyi",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
